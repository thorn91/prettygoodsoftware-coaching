---
import Layout from '../layouts/Layout.astro';
import '../styles/pgs-tokens.css';

const TESTFLIGHT = 'https://testflight.apple.com/join/D4kfw9zp';

const steps = [
  {
    n: '01',
    title: 'Film the angles',
    body:
      'Record in-app, front, back and both sides, without leaving the camera between takes. Or pull a clip in from Photos.',
  },
  {
    n: '02',
    title: 'Talk it through',
    body:
      'Hit record and work the clip the way you would explain it out loud. Scrub back, zoom in, draw on the joint.',
  },
  {
    n: '03',
    title: 'Hand it over',
    body:
      'Play the analysis back, share the marked-up clip, or export a PDF of the moments that matter.',
  },
];

const newBuildReqs = [
  'Any page, any other moment',
  'Two camera angles, or two points in one lift',
  'One cue for both, or one each',
];

const capabilities = [
  {
    title: 'Record the whole analysis',
    body:
      'Your voice, where you scrub, what you zoom into, and every mark as you make it. Hit Play Analysis to watch it back.',
    icon: 'record',
  },
  {
    title: 'Angles that read out degrees',
    body:
      'Set an angle on the joint or drag a measured line. Nothing snaps to a rounder number. The reading is where you put it.',
    icon: 'angle',
  },
  {
    title: 'True frame-by-frame',
    body:
      'Shoot up to 240 fps, play at 1×, ½× or ¼×, and step a frame at a time on the tick strip.',
    icon: 'frame',
  },
  {
    title: 'Up to four angles per clip',
    body:
      'Film front, back and both sides in one go. Each angle keeps its own drawings, so a knee angle measured side-on stays on the side view.',
    icon: 'angles',
  },
  {
    title: 'Trim without destroying',
    body:
      'Cut the settling-in and the slow-down. Nothing is deleted, and any cut can be restored later.',
    icon: 'trim',
  },
  {
    title: 'Send a flat video',
    body:
      'Export the analysis as a plain video with your narration, marks and zoom baked in. No app required to watch it.',
    icon: 'share',
  },
  {
    title: 'A skeleton over the footage',
    body:
      'Turn on live joint tracking through slow motion and frame-by-frame. It runs on the phone.',
    icon: 'skeleton',
  },
];

const screens = [
  { src: '/img/recent.jpg', label: 'Recent', cap: 'pick up where you left off', alt: 'The Recent tab listing saved clips with their thumbnails.' },
  { src: '/img/clients.jpg', label: 'Clients', cap: 'organized by who and what', alt: 'The Clients tab with an Unassigned inbox and a list of clients by injury area.' },
  { src: '/img/angles.jpg', label: 'Add angle', cap: 'up to four on one clip', alt: 'The player overflow menu open on Add angle, offering Record, From Photos and From Files.' },
];

const reportReqs = [
  'US Letter PDF · shares anywhere',
  'Drawings re-rendered, not screenshotted',
  'Toggle any moment out before you send',
];

const installReqs = [
  'iPhone · iOS 17 or later',
  'Free during beta',
  'Feedback goes straight to the developer',
];

// Small line icons, stroked with currentColor so they inherit the accent (teal deep).
const ICONS: Record<string, string> = {
  record: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4.5" fill="currentColor"/>',
  angle: '<path d="M4 20 L20 20"/><path d="M4 20 L16.5 5.5"/><path d="M11 20 a7 7 0 0 0 -2.6 -5.4"/>',
  frame: '<rect x="3" y="6" width="18" height="12" rx="2"/><path d="M9.5 10 l-2.2 2 2.2 2"/><path d="M14.5 10 l2.2 2 -2.2 2"/>',
  trim: '<circle cx="6" cy="7" r="2.5"/><circle cx="6" cy="17" r="2.5"/><path d="M8 8.5 L19 16.5"/><path d="M8 15.5 L19 7.5"/>',
  share: '<path d="M12 15 V4"/><path d="M8 8 l4 -4 4 4"/><path d="M5 12 v6 a1 1 0 0 0 1 1 h12 a1 1 0 0 0 1 -1 v-6"/>',
  angles: '<rect x="3" y="7" width="11" height="10" rx="2"/><path d="M17 10 l4 -2.5 v9 L17 14"/><path d="M6.5 4.5 h9"/><path d="M6.5 19.5 h9"/>',
  skeleton: '<circle cx="12" cy="5" r="1.6"/><path d="M12 6.6 v5.4"/><path d="M12 8 l-4.5 2.5"/><path d="M12 8 l4.5 2.5"/><path d="M12 12 l-3 7"/><path d="M12 12 l3 7"/><circle cx="7.5" cy="10.5" r="1"/><circle cx="16.5" cy="10.5" r="1"/><circle cx="9" cy="19" r="1"/><circle cx="15" cy="19" r="1"/>',
};
const icon = (name: string) =>
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">${ICONS[name] ?? ''}</svg>`;
---

<Layout title="Pretty Good Video Coaching, movement analysis for PTs">
  <Fragment slot="head">
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Frame-accurate movement analysis for clinicians. Measure joint angles, mark up the fix, and send clients a clip they'll understand, all on your iPhone. Now in TestFlight beta."
    />

    <!-- Link previews (iMessage, Slack, etc). Without these a scraper grabs the
         first big image on the page, which is a client's footage — the app icon
         is the right face for a shared link. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Pretty Good Video Coaching" />
    <meta property="og:title" content="Pretty Good Video Coaching" />
    <meta
      property="og:description"
      content="Frame-accurate movement analysis for clinicians. Now in TestFlight beta."
    />
    <meta property="og:url" content="https://coaching.prettygoodsoftware.llc/" />
    <meta property="og:image" content="https://coaching.prettygoodsoftware.llc/img/icon.jpg" />
    <meta property="og:image:width" content="1024" />
    <meta property="og:image:height" content="1024" />
    <meta property="og:image:alt" content="Pretty Good Video Coaching app icon" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Pretty Good Video Coaching" />
    <meta
      name="twitter:description"
      content="Frame-accurate movement analysis for clinicians. Now in TestFlight beta."
    />
    <meta name="twitter:image" content="https://coaching.prettygoodsoftware.llc/img/icon.jpg" />
    <link rel="apple-touch-icon" href="/img/icon.jpg" />
  </Fragment>

  <main class="pg">
    <div class="pg-dotgrid" aria-hidden="true"></div>

    <!-- ============ HEADER ============ -->
    <header class="pg-head">
      <a class="pg-brand" href="/">
        <img src="/img/pgvc-mark-figure.png" width="44" height="44" alt="" />
        <span>Pretty Good<br />Video Coaching</span>
      </a>
      <a class="pg-by" href="https://prettygoodsoftware.llc">by Pretty Good Software</a>
    </header>

    <!-- ============ HERO ============ -->
    <section class="pg-hero">
      <div class="pg-hero-inner">
        <div class="pg-hero-copy pg-clear">
          <p class="pg-eyebrow">TestFlight beta · iPhone · iOS&nbsp;17+</p>
          <h1 class="pg-h1">Pretty Good<br />Video Coaching</h1>
          <p class="pg-lede">Frame-accurate movement analysis for clinicians.</p>
          <p class="pg-sub">
            Capture a client's movement, then record the whole analysis: your
            voice, the frame you scrubbed back to, the angle you drew on the
            joint. They get the explanation, not just the clip.
          </p>
          <div class="pg-cta-row">
            <a class="pg-btn" href={TESTFLIGHT} target="_blank" rel="noopener">
              Join the beta
            </a>
            <a class="pg-btn-ghost" href="#install">Scan to install&nbsp;↓</a>
          </div>
        </div>

        <!-- Real app screenshot: the player measuring a knee, frame by frame -->
        <figure class="pg-device">
          <div class="pg-device-frame">
            <svg class="pg-hero-circles" viewBox="0 0 100 100" aria-hidden="true">
              <defs><clipPath id="hero-lens"><circle cx="40" cy="60" r="30"></circle></clipPath></defs>
              <circle cx="40" cy="60" r="30" fill="#4B3A8C"></circle>
              <circle cx="60" cy="40" r="30" fill="#0E8C86"></circle>
              <circle cx="60" cy="40" r="30" fill="#04204A" clip-path="url(#hero-lens)"></circle>
            </svg>
            <div class="pg-phone">
              <img
                src="/img/player.jpg"
                width="720"
                height="1565"
                alt="The player paused on frame 410 of a squat, with a measured line along the barbell reading 1 degree off level."
              />
            </div>
          </div>
          <figcaption>Frame 410 / 627 · bar 1° off level</figcaption>
        </figure>
      </div>
    </section>

    <!-- ============ THE SESSION, END TO END ============ -->
    <section class="pg-steps">
      <p class="pg-eyebrow">The session, end to end</p>
      <div class="pg-steps-grid">
        {steps.map((s) => (
          <div class="pg-step">
            <span class="pg-step-n">{s.n}</span>
            <h3 class="pg-step-t">{s.title}</h3>
            <p class="pg-step-b">{s.body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ============ NEW IN THIS BUILD ============ -->
    <section class="pg-new">
      <div class="pg-new-inner">
        <figure class="pg-new-shot">
          <img
            src="/img/report-pairs.jpg"
            width="900"
            height="1165"
            alt="A report page showing two stills of a back squat side by side, standing and at the bottom, each with its own timecode and coaching cue underneath."
          />
          <figcaption>An actual page, exported from the app</figcaption>
        </figure>
        <div class="pg-new-copy">
          <p class="pg-eyebrow">New in this build</p>
          <h2 class="pg-h2">Two moments, one page.</h2>
          <p class="pg-new-sub">
            Put a second moment beside any report page: another point in the
            same lift, or another camera on the same moment.
          </p>
          <ul class="pg-reqs pg-reqs-new">
            {newBuildReqs.map((r) => <li>{r}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <!-- ============ CAPABILITIES ============ -->
    <section class="pg-caps">
      <div class="pg-caps-head pg-clear">
        <p class="pg-eyebrow">Around the measurement</p>
        <h2 class="pg-h2 pg-caps-h2">The tools a movement assessment needs.</h2>
      </div>
      <div class="pg-caps-sheet">
        <div class="pg-caps-grid">
          {capabilities.map((c, i) => (
            <article class="pg-cap">
              <div class="pg-cap-top">
                <span class="pg-cap-ico" set:html={icon(c.icon)} />
                <span class="pg-cap-n">{String(i + 1).padStart(2, '0')}</span>
              </div>
              <h3 class="pg-cap-t">{c.title}</h3>
              <p class="pg-cap-b">{c.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ ON YOUR IPHONE ============ -->
    <section class="pg-screens">
      <div class="pg-screens-head pg-clear">
        <p class="pg-eyebrow">On your iPhone</p>
        <h2 class="pg-h2">Every clip, filed under the right client.</h2>
        <p class="pg-screens-sub">
          Shoot into a client from the camera, or drop clips in Unassigned and
          sort them later. One clip holds up to four angles of the same
          movement, each keeping its own drawings. No folders to manage, no
          accounts to set up.
        </p>
      </div>
      <div class="pg-screens-row">
        {screens.map((p) => (
          <figure class="pg-shot">
            <div class="pg-phone"><img src={p.src} width="640" height="1391" alt={p.alt} /></div>
            <figcaption><span class="pg-shot-label">{p.label}</span>{p.cap}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <!-- ============ THE REPORT ============ -->
    <section class="pg-report">
      <div class="pg-report-inner">
        <div class="pg-report-copy">
          <p class="pg-eyebrow">The thing you hand over</p>
          <h2 class="pg-h2">A PDF they can read without the app.</h2>
          <p class="pg-report-sub">
            Step to a frame, tap <strong>+</strong>, and write what they
            should notice. The report prints each moment with its timecode,
            your note and the still, re-rendered at print resolution with
            your marks drawn back in as vectors, not a screenshot of your
            phone.
          </p>
          <ul class="pg-reqs pg-reqs-report">
            {reportReqs.map((r) => <li>{r}</li>)}
          </ul>
        </div>
        <figure class="pg-page">
          <img src="/img/report.jpg" width="880" height="1138" alt="A one-page PDF report titled Movement analysis, showing a squat still with a measured line reading 1 degree, its timecode, and a coaching note." />
          <figcaption>An actual page, exported from the app</figcaption>
        </figure>
      </div>
      <figure class="pg-builder">
        <div class="pg-phone"><img src="/img/builder.jpg" width="640" height="1391" alt="The Build report sheet listing two marked moments with thumbnails, timecodes, include switches and note text." /></div>
        <figcaption>Where you write it: moments, cues, and what makes the cut</figcaption>
      </figure>
    </section>

    <!-- ============ CLIENT PRIVACY ============ -->
    <section class="pg-priv">
      <p class="pg-eyebrow pg-priv-eyebrow">Client privacy</p>
      <p class="pg-priv-line">No accounts. No cloud. No sign-in.</p>
      <p class="pg-priv-sub">
        Clips, drawings and voice notes stay on your iPhone. Nothing about
        your clients leaves the device.
      </p>
    </section>

    <!-- ============ JOIN THE BETA ============ -->
    <section class="pg-install" id="install">
      <div class="pg-install-card">
        <div class="pg-install-copy">
          <p class="pg-eyebrow">Now testing</p>
          <h2 class="pg-h2 pg-install-h2">Join the TestFlight beta</h2>
          <p class="pg-install-sub">
            Scan the code and the app is yours. If it asks you to install
            Apple TestFlight first, install it and then
            <strong>scan again</strong>. Opening TestFlight straight from the
            App Store skips the invite.
          </p>
          <ul class="pg-reqs pg-reqs-install">
            {installReqs.map((r) => <li>{r}</li>)}
          </ul>
          <a class="pg-link" href={TESTFLIGHT} target="_blank" rel="noopener"
            >testflight.apple.com/join/D4kfw9zp</a
          >
          <p class="pg-note">
            Sorry about the extra hop. This is a deliberately small beta, so
            it runs through TestFlight rather than the App Store. I'd rather
            have a handful of clinicians I can actually talk to than a
            download count.
          </p>
        </div>
        <a class="pg-qr" href={TESTFLIGHT} target="_blank" rel="noopener" aria-label="Scan to join the TestFlight beta">
          <div class="pg-qr-card">
            <img src="/img/testflight-qr.svg" width="192" height="192" alt="" />
          </div>
          <span class="pg-qr-cap">Point your camera here</span>
          <span class="pg-qr-cap pg-qr-note">Just installed TestFlight? Scan again.</span>
        </a>
      </div>
    </section>

    <!-- ============ FOOTER ============ -->
    <footer class="pg-foot">
      <div class="pg-foot-brand">
        <img src="/brand/pgvc-mark.svg" width="28" height="28" alt="" />
        <span>Pretty Good Video Coaching, a focused tool for physical therapists, in beta.</span>
      </div>
      <div class="pg-foot-links">
        <a href="/privacy">Privacy</a>
        <a href="/support">Support</a>
        <a class="pg-foot-by" href="https://prettygoodsoftware.llc">by Pretty Good Software</a>
      </div>
    </footer>
  </main>
</Layout>

<style>
  .pg {
    position: relative;
    overflow: hidden;
    font-family: var(--font-body);
    color: var(--ink);
    background: var(--paper);
    -webkit-font-smoothing: antialiased;
  }
  .pg * { box-sizing: border-box; }

  .pg-dotgrid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, var(--rule-firm) 1px, transparent 1.3px);
    background-size: var(--dot-grid-size) var(--dot-grid-size);
    pointer-events: none;
  }
  .pg-clear {
    position: relative;
    background: var(--paper);
    box-shadow: 0 0 0 20px var(--paper), 0 0 36px 32px var(--paper);
  }

  /* ---- shared type ---- */
  .pg-eyebrow {
    font: 500 11px/1.3 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--teal-deep);
    margin: 0 0 18px;
  }
  .pg-h1 {
    font: 600 clamp(2.5rem, 6vw, 4.5rem)/0.98 var(--font-display);
    letter-spacing: -0.03em;
    margin: 0;
  }
  .pg-h2 {
    font: 600 clamp(1.7rem, 3.4vw, 2.75rem)/1.05 var(--font-display);
    letter-spacing: -0.025em;
    margin: 0;
    max-width: 18ch;
  }

  /* ---- buttons ---- */
  .pg-cta-row { display: flex; flex-wrap: wrap; gap: 12px; margin-top: var(--space-6); }
  .pg-btn {
    font: 600 16px/1 var(--font-display);
    background: var(--ink);
    color: var(--paper);
    padding: 14px 22px;
    border-radius: var(--radius-s);
    text-decoration: none;
    transition: background 160ms ease-out;
  }
  .pg-btn:hover { background: var(--overprint-teal); }
  .pg-btn:active { transform: translateY(1px); }
  .pg-btn-ghost {
    font: 600 16px/1 var(--font-display);
    color: var(--ink);
    padding: 14px 20px;
    border-radius: var(--radius-s);
    border: 1px solid var(--rule-firm);
    text-decoration: none;
    transition: border-color 160ms ease-out;
  }
  .pg-btn-ghost:hover { border-color: var(--ink); }

  /* ---- header ---- */
  .pg-head {
    position: relative;
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 22px 32px;
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--rule);
  }
  .pg-brand {
    display: flex;
    gap: 12px;
    align-items: center;
    color: var(--ink);
    text-decoration: none;
  }
  .pg-brand img { border-radius: var(--radius-xs); }
  .pg-brand span {
    font: 600 16px/1.02 var(--font-display);
    letter-spacing: -0.02em;
  }
  .pg-by {
    margin-left: auto;
    font: 400 12px/1.45 var(--font-mono);
    color: var(--ink-muted);
    text-decoration: none;
  }
  .pg-by:hover { color: var(--grape-lit); }

  /* ---- hero ---- */
  .pg-hero {
    position: relative;
    max-width: var(--content-max);
    margin: 0 auto;
    padding: clamp(3.5rem, 8vw, 88px) 32px clamp(3rem, 8vw, 104px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 360px), 1fr));
    gap: clamp(2rem, 5vw, 64px);
    align-items: center;
  }
  .pg-hero-inner { display: contents; }
  .pg-hero-copy { display: flex; flex-direction: column; }
  .pg-lede {
    font: 600 23px/1.3 var(--font-display);
    letter-spacing: -0.01em;
    color: var(--teal-deep);
    margin: var(--space-5) 0 0;
  }
  .pg-sub {
    font: 400 19px/1.55 var(--font-body);
    color: var(--ink-muted);
    max-width: 44ch;
    margin: var(--space-4) 0 0;
    text-wrap: pretty;
  }

  /* ---- device (real screenshots in a phone frame) ---- */
  .pg-device { margin: 0; display: flex; flex-direction: column; align-items: center; gap: 16px; }
  .pg-device-frame { position: relative; display: flex; justify-content: center; width: 100%; }
  .pg-hero-circles {
    position: absolute;
    width: min(560px, 130%);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }
  .pg-phone {
    position: relative;
    width: min(290px, 76vw);
    background: var(--ink);
    padding: 8px;
    border-radius: var(--radius-phone);
  }
  .pg-phone img { display: block; width: 100%; height: auto; border-radius: 38px; }
  .pg-device figcaption {
    font: 400 12px/1.45 var(--font-mono);
    color: var(--ink-muted);
  }

  /* ---- the session, end to end ---- */
  .pg-steps {
    position: relative;
    border-top: 1px solid var(--rule);
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 72px 32px 88px;
  }
  .pg-steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 20px;
    margin-top: 36px;
  }
  .pg-step {
    background: var(--paper-lit);
    border: 1px solid var(--rule);
    border-radius: var(--radius-m);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .pg-step-n { font: 500 15px/1.4 var(--font-mono); color: var(--teal-deep); }
  .pg-step-t { font: 600 24px/1.15 var(--font-display); letter-spacing: -0.015em; margin: 0; }
  .pg-step-b { font: 400 17px/1.55 var(--font-body); color: var(--ink-muted); margin: 0; text-wrap: pretty; }

  /* ---- new in this build ---- */
  .pg-new {
    position: relative;
    background: var(--teal-soft);
    border-top: 1px solid var(--teal);
    border-bottom: 1px solid var(--teal);
  }
  .pg-new-inner {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 88px 32px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: clamp(2rem, 5vw, 64px);
    align-items: center;
  }
  .pg-new-shot { margin: 0; display: flex; flex-direction: column; align-items: center; gap: 14px; }
  .pg-new-shot img {
    width: min(400px, 100%);
    height: auto;
    border-radius: var(--radius-xs);
    border: 1px solid var(--teal);
  }
  .pg-new-shot figcaption { font: 400 12px/1.45 var(--font-mono); color: var(--overprint-teal); }
  .pg-new-copy { display: flex; flex-direction: column; color: var(--overprint-teal); }
  .pg-new-copy .pg-eyebrow { color: inherit; }
  .pg-new-sub { font: 400 19px/1.55 var(--font-body); max-width: 44ch; margin: var(--space-4) 0 0; text-wrap: pretty; }

  /* ---- shared "reqs" bullet lists ---- */
  .pg-reqs {
    list-style: none;
    padding: 0;
    margin: 28px 0 0;
    display: flex;
    flex-direction: column;
  }
  .pg-reqs li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 0;
    font: 500 14px/1.4 var(--font-mono);
  }
  .pg-reqs li::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: var(--radius-xs);
    flex: none;
  }
  .pg-reqs-new li { border-top: 1px solid var(--teal); }
  .pg-reqs-new li::before { background: var(--overprint-teal); }
  .pg-reqs-report li,
  .pg-reqs-install li { border-top: 1px solid var(--rule); color: var(--ink); }
  .pg-reqs-report li::before,
  .pg-reqs-install li::before { background: var(--teal); }

  /* ---- capabilities ---- */
  .pg-caps {
    position: relative;
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 104px 32px 88px;
  }
  .pg-caps-head { width: fit-content; }
  .pg-caps-h2 { max-width: 18ch; }
